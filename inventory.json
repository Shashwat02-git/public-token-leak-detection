import json
import os

from hvac import Client

# Initialize Vault client
client = Client(url=os.environ.get("VAULT_ADDR"), token=os.environ.get("VAULT_TOKEN"))

# Fetch the secret from Vault
vault_secret_path = 'vault://kv//Shashwat02-git/public-token-leak-detection/inventory.json'
try:
    read_response = client.secrets.kv.v2.read_secret_version(path=vault_secret_path)
    github_token = read_response['data']['data']['github_token']
except Exception as e:
    print(f"Error fetching secret from Vault: {e}")
    github_token = None

